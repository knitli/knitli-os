// Type-checks the gatekeeper-linear tests separately, so the Worker-pool declarations stay out
// of the production source check.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["./worker-configuration.d.ts", "@cloudflare/vitest-plugin/types"]
  },
  "include": ["src", "__tests__"],
  // Upstream's observers.test.ts (#1011) reads `variables.filter.key` unchecked, which this stricter
  // check rejects; it is upstream's file, so it stays out of the fork's test type-check.
  "exclude": ["__tests__/observers.test.ts"]
}
