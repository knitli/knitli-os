{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    // Node for the test process itself, plus Workers types for the fixture Worker and because the
    // shared RPC API's types reference Workers globals (Fetcher, cloudflare:workers).
    "types": ["node", "@cloudflare/workers-types"],
    "noEmit": true,
    "paths": {
      "@gadgets/workshop-shared/*": ["../workshop-shared/src/*"]
    }
  },
  "include": ["src", "__tests__", "fixtures"],
  // Runtime wrappers import generated validation output, which is bundled rather than type-checked.
  "exclude": ["node_modules", "fixtures/fork/workshop-reload-probe.js", "fixtures/fork/gatekeeper-reload-probe.js"]
}
