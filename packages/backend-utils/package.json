{
  "name": "@gadgets/backend-utils",
  "version": "1.0.0",
  "description": "Shared Worker-side libraries; not a standalone deployable Worker.",
  "type": "module",
  "exports": {
    "./access": {
      "types": "./src/access.ts",
      "import": "./src/access.ts"
    },
    "./fork/connect-initiator": {
      "types": "./src/fork/connect-initiator.ts",
      "import": "./src/fork/connect-initiator.ts"
    },
    "./logger": {
      "types": "./src/logger.ts",
      "import": "./src/logger.ts"
    },
    "./observability-context": {
      "types": "./src/observability-context.ts",
      "import": "./src/observability-context.ts"
    },
    "./tracing": {
      "types": "./src/tracing.ts",
      "import": "./src/tracing.ts"
    },
    "./error-reporting": {
      "types": "./src/error-reporting.ts",
      "import": "./src/error-reporting.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "test:run": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@gadgets/error-reporting": "workspace:*",
    "@gadgets/workshop-shared": "workspace:*",
    "jose": "^6.2.8"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@gadgets/scripts": "workspace:*",
    "vitest": "catalog:"
  }
}
