{
  "name": "@gadgets/gatekeeper-ai-executor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/ai-executor.ts",
  "scripts": {
    "build": "capnweb-validate build --out .wrangler/validate && tsc --noEmit",
    "clean": "rm -rf .wrangler dist",
    "test": "capnweb-validate build --out .wrangler/validate && vitest run --config vite.config.ts && vitest run --config vitest.worker.config.ts",
    "test:node": "vitest run --config vite.config.ts",
    "test:workerd": "vitest run --config vitest.worker.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@gadgets/workshop-shared": "workspace:*",
    "capnweb": "catalog:",
    "capnweb-validate": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "catalog:",
    "@cloudflare/workers-types": "^5.20260808.1",
    "miniflare": "5.20260801.0-alpha",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
